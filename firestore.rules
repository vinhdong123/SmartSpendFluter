rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hồ sơ công khai (email + tên) để tìm người khi thêm vào nhóm,
    // và dữ liệu cá nhân được sao lưu: chỉ chủ tài khoản được ghi/đọc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{table}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Nhóm chia tiền: chỉ thành viên trong memberUids được đọc/ghi.
    match /groups/{gid} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;
      allow read, update: if request.auth != null
                    && request.auth.uid in resource.data.memberUids;
      allow delete: if false;

      match /{sub}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
      }
    }
  }
}
